# Web
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_ENV=development

# Database
DATABASE_URL=

# Queue
REDIS_URL=

# Object storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Worker API
CONVERSION_API_URL=
CONVERSION_API_SECRET=
SITE_ORIGIN=http://localhost:3000
# Set only behind a trusted edge that overwrites this header; never trust arbitrary X-Forwarded-For.
TRUSTED_CLIENT_IP_HEADER=

# Security
JOB_TOKEN_SECRET=
SIGNED_URL_TTL_SECONDS=300
FILE_RETENTION_SECONDS=3600
RUNNER_SECRET=
RUNNER_URL=
S3_PUBLIC_ENDPOINT=

# Monitoring
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Analytics/Ads (Phase 10 AdSense foundation)
# Keep empty and disabled until approved publisher credentials are provided by the operator.
# Example client ID format: ca-pub-XXXXXXXXXXXXXXXX (never commit real credentials)
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_ENABLED=false
# Test mode renders accessible preview placeholders without third-party scripts
NEXT_PUBLIC_ADSENSE_TEST_MODE=false
# Optional slot IDs (empty = auto-responsive slots)
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_AFTER_CONVERTER=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_IN_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_AFTER_HERO=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_BETWEEN_SECTIONS=
NEXT_PUBLIC_ADSENSE_SLOT_DIRECTORY_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_FORMATS_BOTTOM=
# Consent Management Platform (CMP / IAB TCF v2.2)
NEXT_PUBLIC_CMP_ENABLED=false
NEXT_PUBLIC_CMP_SCRIPT_URL=
# ads.txt override (defaults to generated record from NEXT_PUBLIC_ADSENSE_CLIENT_ID or pending notice)
NEXT_PUBLIC_ADS_TXT_CONTENT=

# Optional external AI processing (disabled unless explicitly configured).
# Keys are server-only and are passed to the API container, never the web client or workers.
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=

# Oracle production (server-only). Browser tools do not need these values.
TRANSFER_PUBLIC_URL=
TRANSFER_TOKEN_SECRET=
PRODUCTION_CONVERSIONS_ENABLED=false
# Empty denies all server converters, even if the global switch is enabled.
PRODUCTION_TOOL_ALLOWLIST=
ORACLE_API_HOST=
TLS_EMAIL=

# Public SEO/trust configuration (no private credentials)
FILENIMBLE_SUPPORT_EMAIL=
GOOGLE_SITE_VERIFICATION=
